# ── Public / shared hosting ──────────────────────────────────────────
# Leave all paid API keys EMPTY on the public deployment.
# AI features use Bring Your Own Key (BYOK) from the browser session.

HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/runs.db
PUBLIC_APP_URL=https://names.seanduncombe.com
GITHUB_REPO_URL=https://github.com/sduncombe/startup-name-generator

# Public default: do NOT allow server-side LLM keys
ALLOW_SERVER_LLM_KEYS=false

# Free / safely rate-limited domain checks (RDAP)
DOMAIN_PROVIDER=rdap
DOMAIN_CHECK_CONCURRENCY=3
DOMAIN_CHECK_TIMEOUT_SECONDS=8

# Optional registrar API for private self-hosting only (leave empty publicly)
DOMAIN_API_KEY=
DOMAIN_API_SECRET=

# Optional private self-host LLM keys — only used if ALLOW_SERVER_LLM_KEYS=true
# Never commit real values. Public deployment must leave these unset.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
XAI_BASE_URL=https://api.x.ai/v1

LLM_NAME_COUNT=48
RADIO_TEST_TOP=80
